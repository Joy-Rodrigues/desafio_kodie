# Copie este arquivo para .env e preencha. NUNCA suba o .env para o GitHub.

# Provedor de IA: gemini | openai | mock
#   gemini -> Google Gemini (tem plano gratuito, chave em https://aistudio.google.com/apikey)
#   openai -> qualquer API compatível com /chat/completions (OpenAI, Groq, OpenRouter...)
#   mock   -> classificação falsa por palavras-chave, sem chave (só para testar o fluxo)
LLM_PROVIDER=gemini

# Chave da API do provedor escolhido (não é usada com LLM_PROVIDER=mock)
LLM_API_KEY=

# Modelo (opcional). Padrões: gemini-2.5-flash (gemini) e gpt-4o-mini (openai)
LLM_MODEL=

# Só para LLM_PROVIDER=openai. Exemplo Groq: https://api.groq.com/openai/v1
LLM_BASE_URL=https://api.openai.com/v1

# Timeout da chamada à IA, em segundos
LLM_TIMEOUT=30

# Pasta onde os encaminhamentos são gravados
DATA_DIR=data
